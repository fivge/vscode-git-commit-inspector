{
  "name": "git-commit-inspector",
  "displayName": "Git Commit Inspector",
  "description": "Inspect a Git commit from its SHA in the integrated terminal.",
  "version": "1.0.0",
  "publisher": "fivge",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fivge/vscode-git-commit-inspector.git"
  },
  "homepage": "https://github.com/fivge/vscode-git-commit-inspector#readme",
  "bugs": {
    "url": "https://github.com/fivge/vscode-git-commit-inspector/issues"
  },
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitCommitInspect.inspectCommit",
        "title": "Inspect Commit...",
        "category": "Git Commit Inspector",
        "icon": "$(search)"
      },
      {
        "command": "gitCommitInspect.refresh",
        "title": "Refresh",
        "category": "Git Commit Inspector",
        "icon": "$(refresh)"
      },
      {
        "command": "gitCommitInspect.copyCommitValue",
        "title": "Copy",
        "category": "Git Commit Inspector"
      },
      {
        "command": "gitCommitInspect.clear",
        "title": "Clear",
        "category": "Git Commit Inspector",
        "icon": "$(clear-all)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitCommitInspect",
          "title": "Commit Inspect",
          "icon": "resources/commit-inspect.svg"
        }
      ]
    },
    "views": {
      "gitCommitInspect": [
        {
          "id": "gitCommitInspect.files",
          "name": "Files Changed",
          "icon": "resources/files-changed.svg",
          "contextualTitle": "Git Commit Inspector: Files Changed"
        },
        {
          "id": "gitCommitInspect.commit",
          "name": "Commit",
          "icon": "resources/commit.svg",
          "contextualTitle": "Git Commit Inspector: Commit"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "gitCommitInspect.refresh",
          "when": "gitCommitInspect.hasCommit && view == gitCommitInspect.files",
          "group": "navigation@1"
        },
        {
          "command": "gitCommitInspect.clear",
          "when": "gitCommitInspect.hasCommit && view == gitCommitInspect.files",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "gitCommitInspect.copyCommitValue",
          "when": "view == gitCommitInspect.commit && viewItem == commitInfo.copyable",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "gitCommitInspect.copyCommitValue",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Git Commit Inspector",
      "properties": {
        "gitCommitInspect.terminalLinks.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable commit SHA links in the integrated terminal."
        },
        "gitCommitInspect.terminalLinks.minHashLength": {
          "type": "integer",
          "default": 7,
          "minimum": 4,
          "maximum": 40,
          "description": "Minimum length of a Git SHA recognized in the integrated terminal."
        }
      }
    }
  },
  "scripts": {
    "build": "bun run esbuild.mjs",
    "watch": "bun run esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "bun test test/unit",
    "build:test": "bun run esbuild.mjs --tests",
    "test:integration": "bun run build && bun run build:test && bun test/integration/runTest.ts",
    "package": "bun run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest",
    "@types/vscode": "^1.136.0",
    "@vscode/test-electron": "latest",
    "@vscode/vsce": "latest",
    "esbuild": "latest",
    "eslint": "latest",
    "typescript": "6.0.3",
    "typescript-eslint": "latest"
  }
}
